<!DOCTYPE html>
<html lang="hi">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Extruded PVC Ceiling Panel Finishes</title>
  <style>
    :root {
      --bg: #f8f4ee;
      --card: #fff;
      --ink: #3b2a20;
      --mute: #8a7a6d;
      --line: #e6ddd2;
      --accent: #b8975f;
      --accent-ink: #fff;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px)
    }

    @media (prefers-color-scheme:dark) {
      :root:not([data-theme="light"]) {
        --bg: #1d1611;
        --card: #2a201a;
        --ink: #f1e6d8;
        --mute: #a8988a;
        --line: #3e3128;
        --accent: #c9a86a;
        --accent-ink: #1d1611
      }
    }

    :root[data-theme="dark"] {
      --bg: #1d1611;
      --card: #2a201a;
      --ink: #f1e6d8;
      --mute: #a8988a;
      --line: #3e3128;
      --accent: #c9a86a;
      --accent-ink: #1d1611
    }

    * {
      box-sizing: border-box
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: "Space Grotesk", system-ui, sans-serif
    }

    .wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 40px 20px
    }

    .badge {
      display: inline-block;
      background: var(--accent);
      color: var(--accent-ink);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .08em;
      padding: 8px 16px;
      border-radius: 99px
    }

    .head {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
      justify-content: space-between;
      margin: 14px 0 24px
    }

    h1 {
      margin: 0;
      font-size: clamp(22px, 4vw, 32px)
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px
    }

    .filters button {
      font: inherit;
      font-size: 13px;
      font-weight: 700;
      padding: 10px 18px;
      border-radius: 99px;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--ink);
      cursor: pointer
    }

    .filters button.on {
      background: var(--accent);
      color: var(--accent-ink);
      border-color: var(--accent)
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 16px
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden
    }

    .panel {
      height: 190px;
      transition: background .25s
    }

    .info {
      padding: 12px 12px 14px;
      text-align: center
    }

    .name {
      font-size: 13px;
      font-weight: 700
    }

    .name span {
      color: var(--mute);
      font-weight: 400
    }

    .types {
      display: flex;
      gap: 6px;
      justify-content: center;
      margin-top: 10px
    }

    .types button {
      font: inherit;
      font-size: 12px;
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 7px 10px;
      border-radius: 99px;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--mute);
      cursor: pointer
    }

    .types button.on {
      border-color: var(--accent);
      color: var(--ink);
      background: color-mix(in srgb, var(--accent) 16%, transparent);
      font-weight: 700
    }

    .types button:focus-visible,
    .filters button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px
    }

    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      border: 1px solid rgba(0, 0, 0, .25)
    }

    .note {
      margin-top: 28px;
      font-size: 13px;
      color: var(--mute)
    }
  </style>
</head>

<body>
  <div class="wrap">
    <span class="badge">COLOUR &amp; FINISH LIBRARY</span>
    <div class="head">
      <h1>Extruded PVC Ceiling Panel Finishes</h1>
      <div class="filters" id="filters"></div>
    </div>
    <div class="grid" id="grid"></div>
    <p class="note">Demo: har card mein Simple / Golden / Copper buttons dabakar panel ki line badal kar dekho.</p>
  </div>
  <script>
    // Yahan apne 28 colours add karo: sirf naam, code, category, aur base colour badlo.
    const COLORS = [
      { n: "Vintage Walnut", c: "001", cat: "wooden", b: "#5a2a1c" },
      { n: "Natural White", c: "002", cat: "plain", b: "#dfeef2" },
      { n: "Teak Wood", c: "003", cat: "wooden", b: "#6b2f1a" },
      { n: "Heritage Walnut", c: "004", cat: "wooden", b: "#7a4322" },
      { n: "Oak Wood", c: "005", cat: "wooden", b: "#5d2a17" },
      { n: "Classic Walnut", c: "006", cat: "wooden", b: "#a4622f" },
      { n: "Golden Oak", c: "007", cat: "wooden", b: "#b5471f" },
      { n: "Retro Wood", c: "008", cat: "wooden", b: "#6e3a2c" },
      { n: "Desert Oak", c: "010", cat: "wooden", b: "#a08a6e" },
      { n: "Honey Oak", c: "011", cat: "wooden", b: "#d9a35f" },
      { n: "Carrara White", c: "101", cat: "marble", b: "#e9e7e4" },
      { n: "Nero Marble", c: "102", cat: "marble", b: "#2b2b2e" },
      { n: "Stone Grey", c: "201", cat: "plain", b: "#9a9a98" },
      { n: "Sand Stone", c: "202", cat: "plain", b: "#cdb99b" }
    ];
    const TYPES = [
      { k: "simple", label: "Simple", line: "#151010", dot: "#151010" },
      { k: "golden", label: "Golden", line: "#d8b04a", dot: "#d8b04a" },
      { k: "copper", label: "Copper", line: "#b8683a", dot: "#b8683a" }
    ];
    const CATS = [{ k: "all", l: "ALL" }, { k: "wooden", l: "WOODEN TEXTURE" }, { k: "plain", l: "PLAIN / STONE" }, { k: "marble", l: "MARBLE DESIGN" }];
    let cat = "all";

    function bg(base, line) {
      const g = "repeating-linear-gradient(90deg,rgba(255,255,255,.05) 0 2px,rgba(0,0,0,.06) 2px 5px)";
      const l = (p) => `transparent calc(${p}% - 2px),${line} calc(${p}% - 2px),${line} calc(${p}% + 2px),transparent calc(${p}% + 2px)`;
      return `linear-gradient(90deg,transparent calc(33.33% - 2px),${line} calc(33.33% - 2px),${line} calc(33.33% + 2px),transparent calc(33.33% + 2px),transparent calc(66.66% - 2px),${line} calc(66.66% - 2px),${line} calc(66.66% + 2px),transparent calc(66.66% + 2px)),${g},${base}`;
    }
    function render() {
      const list = COLORS.filter(x => cat === "all" || x.cat === cat);
      const grid = document.getElementById("grid");
      grid.innerHTML = "";
      list.forEach(x => {
        const card = document.createElement("div"); card.className = "card";
        card.innerHTML = `<div class="panel"></div><div class="info"><div class="name">${x.n} <span>(${x.c})</span></div><div class="types"></div></div>`;
        const panel = card.querySelector(".panel"), types = card.querySelector(".types");
        const set = (t) => { panel.style.background = bg(x.b, t.line); types.querySelectorAll("button").forEach(b => b.classList.toggle("on", b.dataset.k === t.k)) };
        TYPES.forEach(t => {
          const b = document.createElement("button"); b.dataset.k = t.k;
          b.innerHTML = `<span class="dot" style="background:${t.dot}"></span>${t.label}`;
          b.onclick = () => set(t); types.appendChild(b);
        });
        set(TYPES[0]); grid.appendChild(card);
      });
    }
    function filters() {
      const f = document.getElementById("filters"); f.innerHTML = "";
      CATS.forEach(c => {
        const n = c.k === "all" ? COLORS.length : COLORS.filter(x => x.cat === c.k).length;
        const b = document.createElement("button"); b.textContent = `${c.l} (${n})`;
        b.className = c.k === cat ? "on" : "";
        b.onclick = () => { cat = c.k; filters(); render() }; f.appendChild(b);
      });
    }
    filters(); render();
  </script>
</body>

</html>